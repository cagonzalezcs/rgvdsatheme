{% if primary_menu %}
	{%
		set header_props = {
			menu: primary_menu
		}
	%}
	<header class="header" data-vue-island="SiteHeader" data-props="{{ header_props|json_encode|e("html_attr") }}">
		<div class="wrapper">
			<h1 class="hdr-logo" role="banner">
				<a class="hdr-logo-link" href="{{site.url}}" rel="home">{{site.name}}</a>
			</h1>
			<nav id="nav-main" class="nav-main" role="navigation">

					<ul>
						{% for item in primary_menu.get_items %}
							<li class="{{ item.classes | join(' ') }}">
								<a target="{{ item.target }}" href="{{ item.link }}">{{ item.title }}</a>
							</li>
						{% endfor %}
					</ul>

			</nav><!-- #nav -->
		</div>
	</header>
{% endif %}