{% extends "base.twig" %}

{# Interior page template — PageHeader band + content/sidebar grid + grievance callout. #}

{% block content %}
	{% set page_header_props = {
		title: post.title,
		lede: post.post_excerpt|default(''),
		crumbs: [{ label: 'Home', href: '/' }]
	} %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	<div class="interior-page bg-cream px-6 py-16" data-tone="cream">
		<div class="mx-auto grid max-w-[1100px] items-start gap-14 [grid-template-columns:minmax(300px,1fr)_300px] max-lg:[grid-template-columns:1fr]">

			<article id="post-{{ post.ID }}" class="post-type-{{ post.post_type }} prose-rgv min-w-0">
				{{ post.content }}

				<aside id="grievance" class="callout-card mt-12 border-[3px] border-ink bg-white p-7 shadow-brutal-red">
					<div class="mb-3 text-[0.85rem] font-extrabold uppercase tracking-[0.18em] text-brand-red">Need to report something?</div>
					<p class="m-0 text-base leading-relaxed">
						If you&rsquo;ve experienced or witnessed a violation of our Code of Conduct, contact the grievance officer at
						<a href="mailto:hello@example.org">hello@example.org</a>. Reports are handled per our Grievance Policy — confidentially and seriously.
					</p>
				</aside>
			</article>

			<aside class="interior-sidebar flex flex-col gap-6 max-lg:hidden" aria-label="Page navigation and related links">
				<nav class="border-2 border-ink bg-white p-5" aria-label="On this page">
					<div class="mb-3 font-display text-[0.85rem] font-extrabold uppercase tracking-[0.12em]">On this page</div>
					<div class="flex flex-col gap-2">
						<a href="#documents" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">Governing documents</a>
						<a href="#conduct" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">What we expect</a>
						<a href="#grievance" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">Reporting a grievance</a>
					</div>
				</nav>

				<div class="border-2 border-ink bg-white p-5">
					<div class="mb-3 font-display text-[0.85rem] font-extrabold uppercase tracking-[0.12em]">Related</div>
					<div class="flex flex-col gap-2">
						<a href="/get-involved/" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">Get involved</a>
						<a href="/calendar/" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">Event calendar</a>
						<a href="/get-involved/#faq" class="text-[0.95rem] font-bold text-ink no-underline hover:text-brand-red">FAQ</a>
					</div>
				</div>

				<div class="border-[3px] border-ink bg-brand-red p-5 text-cream shadow-brutal" data-tone="red">
					<div class="mb-2 font-display text-[1.05rem] font-extrabold uppercase">New here?</div>
					<p class="m-0 mb-4 text-[0.95rem] leading-relaxed">Start with RGV-DSA 101 — our intro session for new and curious folks.</p>
					<a href="/calendar/" class="inline-block border-2 border-cream bg-cream px-4 py-2 text-[0.85rem] font-extrabold uppercase tracking-[0.05em] text-brand-red no-underline hover:border-brand-red-deep hover:bg-brand-red-deep hover:text-white">Find a session</a>
				</div>
			</aside>

		</div>
	</div>
{% endblock %}
