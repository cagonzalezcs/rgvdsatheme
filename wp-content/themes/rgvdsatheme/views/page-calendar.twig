{% extends "base.twig" %}

{#
  Calendar page. inc/events.php always sets calendar_api_base /
  calendar_ics_url / calendar_gcal_url; the island fetches its event window
  from /rgvdsa/v1/events on mount (skeleton state) and owns the designed
  empty/error states.
#}

{% block content %}
	{% set page_header_props = {
		title: 'Event Calendar',
		lede: 'Meetings, actions, trainings, and socials across the Valley. Everything is open to the public unless noted — bring a friend.',
		crumbs: [{ label: 'Home', href: '/' }]
	} %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	{% set calendar_props = {
		apiBase: calendar_api_base,
		defaultView: 'month',
		showCategoryColors: true,
		showSubscribe: true,
		icsUrl: calendar_ics_url,
		googleCalUrl: calendar_gcal_url
	} %}
	<div data-vue-island="EventCalendar" data-props='{{ calendar_props|json_encode|e("html_attr") }}'></div>
{% endblock %}
