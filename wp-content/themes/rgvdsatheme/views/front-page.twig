{% extends "base.twig" %}

{#
  Home page — v2 (warm/rounded) skin. Hero, counties, events, and blog teasers
  are WP/ACF-driven (see inc/options.php, inc/events.php, inc/blog.php); the
  literals below are safe fallbacks for the pre-seed / preview render.
  Ported from design_handoff_rgvdsa_vue/designs/RGV DSA Home.dc.html.
#}

{% set show_counties_strip = show_counties_strip|default(true) %}
{% set event_count = event_count|default(5) %}
{# calendar_url comes from inc/events.php (rgvdsa_events_calendar_url()). #}
{% set calendar_url = calendar_url|default('/calendar/') %}
{# home_events comes from rgvdsa_events_front_page_context() — always set
   (possibly empty); the empty state below owns the pre-seed render. #}
{% set home_events = home_events|default([]) %}
{# counties + hero come from inc/options.php (rgvdsa_chapter_counties / rgvdsa_front_hero). #}
{% set counties = counties|default([]) %}
{#
  blog_featured (map|null) and blog_rows (array) come from
  rgvdsa_blog_front_page_context() with a raw `cat` slug. Literal class maps
  keep the Tailwind JIT scanner able to see every category utility.
#}
{% set cat_featured_pill = {
	chapter: 'bg-cat-chapter', poled: 'bg-cat-poled', mutual: 'bg-cat-mutual',
	labor: 'bg-cat-labor', electoral: 'bg-cat-electoral', social: 'bg-cat-social'
} %}
{% set cat_row_pill = {
	chapter: 'text-cat-chapter border-cat-chapter', poled: 'text-cat-poled border-cat-poled',
	mutual: 'text-cat-mutual border-cat-mutual', labor: 'text-cat-labor border-cat-labor',
	electoral: 'text-cat-electoral border-cat-electoral', social: 'text-cat-social border-cat-social'
} %}
{% set stripe = 'bg-[repeating-linear-gradient(45deg,var(--color-stripe-v2-a)_0_14px,var(--color-stripe-v2-b)_14px_28px)]' %}

{% block content %}

	{# ============ HERO ============ #}
	<section class="home-hero bg-brand-red px-4 py-14 text-white md:px-6 md:py-20 lg:py-[88px]" data-tone="red">
		<div class="mx-auto flex max-w-[1140px] flex-col items-start gap-8 md:flex-row md:items-center md:gap-12">
			<div class="flex w-full flex-none flex-col items-start gap-6 md:w-auto md:flex-[1_1_520px] md:gap-7">
				<span class="rounded-full bg-white px-[18px] py-[7px] text-[0.85rem] font-bold uppercase tracking-[0.1em] text-red">Rio Grande Valley Democratic Socialists</span>
				<h1 class="m-0 max-w-[18ch] font-display text-[clamp(2.3rem,5.6vw,4rem)] font-black leading-[1.08] tracking-[-0.01em] [text-wrap:balance]">
					{{ hero.heading }}
				</h1>
				<p class="m-0 max-w-[44ch] text-[1.02rem] font-normal leading-[1.5] md:text-[1.15rem] lg:text-[1.5rem]">
					{{ hero.lede }}
				</p>
				<div class="flex w-full flex-col items-stretch gap-3 md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-3.5">
					<a href="{{ hero.cta_primary_url }}" target="_blank" rel="noopener"
						class="w-full rounded-full bg-white px-[34px] py-4 text-center text-[1.05rem] font-bold text-red no-underline shadow-[0_4px_14px_rgba(28,25,23,0.25)] transition-transform hover:-translate-y-px hover:text-red-hover md:w-auto">
						{{ hero.cta_primary_label }}
					</a>
					<a href="{{ hero.cta_secondary_url }}"
						class="w-full rounded-full bg-ink px-[34px] py-4 text-center text-[1.05rem] font-bold text-white no-underline transition-colors hover:bg-ink-soft md:w-auto">
						{{ hero.cta_secondary_label }}
					</a>
				</div>
				<span class="rounded-full bg-[rgba(28,25,23,0.85)] px-[18px] py-2 text-[0.95rem]">New here? Start with <strong class="notranslate">RGV-DSA 101</strong> — no experience needed.</span>
			</div>
			<img src="{{ site.theme.link }}/static/images/logos/logo-lg.png" alt="" aria-hidden="true"
				class="mx-auto block h-auto w-full max-w-[150px] md:max-w-[190px] md:flex-[1_1_360px] lg:max-w-[800px]">
		</div>
	</section>

	{# ============ COUNTIES STRIP ============ #}
	{% if show_counties_strip %}
		<section id="counties" class="counties-strip bg-ink px-4 py-5 text-white md:px-6" data-tone="ink" aria-label="Communities we serve">
			<div class="mx-auto flex max-w-[1200px] flex-wrap justify-center gap-x-[18px] gap-y-2 font-display text-[0.75rem] font-bold uppercase tracking-[0.05em] md:text-[0.92rem]">
				{% for county in counties %}
					<span class="notranslate">{{ county }}</span>{% if not loop.last %}<span aria-hidden="true" class="text-brand-red">★</span>{% endif %}
				{% endfor %}
			</div>
		</section>
	{% endif %}

	{# ============ WHO WE ARE ============ #}
	<section id="about" class="who-we-are bg-white px-4 py-16 md:px-6 md:py-24" data-tone="cream">
		<div class="mx-auto grid max-w-[1140px] grid-cols-1 items-center gap-10 md:gap-16 md:[grid-template-columns:minmax(300px,1.1fr)_minmax(280px,0.9fr)]">
			<div class="flex flex-col gap-5">
				<div class="text-[0.82rem] font-bold uppercase tracking-[0.14em] text-red">Who we are</div>
				<h2 class="m-0 font-display text-[clamp(1.7rem,3.6vw,2.5rem)] font-extrabold leading-[1.15] tracking-[-0.01em]">We are <span class="notranslate">DSA-RGV</span></h2>
				<p class="m-0 text-[1.08rem] leading-[1.75] text-text-body">
					The RGV is one of the most economically unequal regions in the country — but it doesn&rsquo;t have to stay that way. As democratic socialists, we&rsquo;re building working-class power to challenge the dominance of the wealthy and the powerful across our border communities.
				</p>
				<p class="m-0 text-[1.08rem] leading-[1.75] text-text-body">
					Together, we&rsquo;re fighting for a Valley where working people have real power, and where everyone can live a dignified life — regardless of where they were born or how they got here.
				</p>
				<a href="/about/" class="self-start text-base font-bold text-red no-underline hover:underline hover:underline-offset-4">More about our chapter →</a>
			</div>
			{% if about_image %}
				<figure class="m-0 aspect-[4/3] overflow-hidden rounded-[18px] shadow-photo">
					<img src="{{ about_image.src }}" alt="{{ about_image.alt }}" class="h-full w-full object-cover">
				</figure>
			{% else %}
				<figure class="m-0 aspect-[4/3] overflow-hidden rounded-[18px] shadow-photo {{ stripe }}" aria-hidden="true"></figure>
			{% endif %}
		</div>
	</section>

	{# ============ UPCOMING EVENTS ============ #}
	<section id="events" class="upcoming-events bg-off-white px-4 py-14 md:px-6 md:py-[88px]" data-tone="cream">
		<div class="mx-auto flex max-w-[1140px] flex-col gap-9">
			<div class="flex flex-wrap items-baseline justify-between gap-4">
				<h2 class="m-0 font-display text-[clamp(1.7rem,3.6vw,2.5rem)] font-extrabold leading-[1.15] tracking-[-0.01em]">Upcoming events</h2>
				<a href="{{ calendar_url }}" class="text-base font-bold text-red no-underline hover:underline hover:underline-offset-4">Full calendar →</a>
			</div>
			{% if home_events is empty %}
				<div class="flex flex-col items-center gap-2.5 rounded-[16px] border-2 border-dashed border-border-control px-8 py-12 text-center">
					<div class="font-display text-[1.2rem] font-bold">No events on the books yet</div>
					<p class="m-0 max-w-[48ch] text-base leading-[1.6] text-text-muted">New meetings and actions land on the <a href="{{ calendar_url }}" class="font-bold text-red">calendar</a> first — subscribe there and never miss one.</p>
				</div>
			{% endif %}
			<div class="flex flex-col gap-3">
				{% for ev in home_events|slice(0, event_count) %}
					{# Whole row is the tap target on mobile (05 §4 Home); the pill becomes a
					   visual span at md+ and an inline "View event →" shows on mobile. #}
					<a href="{{ ev.url|default(calendar_url) }}" aria-label="View event: {{ ev.title }}"
						class="group grid grid-cols-[64px_1fr] items-center gap-4 rounded-[14px] bg-white px-[22px] py-[18px] text-ink no-underline shadow-subtle transition-shadow hover:shadow-card md:[grid-template-columns:76px_1fr_auto] md:gap-6">
						<div aria-hidden="true" class="flex flex-col rounded-[12px] bg-brand-red px-1 py-2.5 text-center text-white">
							<span class="font-display text-[1.4rem] font-extrabold leading-[1.1]">{{ ev.day }}</span>
							<span class="text-[0.72rem] font-bold tracking-[0.1em]">{{ ev.month }}</span>
						</div>
						<div class="flex flex-col gap-1">
							<div class="text-[1.12rem] font-bold">{{ ev.title }}</div>
							<div class="text-[0.95rem] text-text-muted">{{ ev.when }} · {{ ev.where }}</div>
							<span class="mt-1 text-[0.92rem] font-bold text-red md:hidden">View event →</span>
						</div>
						<span aria-hidden="true"
							class="hidden whitespace-nowrap rounded-full border-2 border-red px-5 py-[9px] text-[0.92rem] font-bold text-red transition-colors group-hover:border-red-hover group-hover:bg-wash md:inline-block">
							View event
						</span>
					</a>
				{% endfor %}
			</div>
		</div>
	</section>

	{# ============ FROM THE BLOG ============ #}
	<section id="blog" class="from-the-blog bg-white px-4 py-14 md:px-6 md:py-[88px]" data-tone="cream">
		<div class="mx-auto flex max-w-[1140px] flex-col gap-9">
			<div class="flex flex-wrap items-baseline justify-between gap-4">
				<h2 class="m-0 font-display text-[clamp(1.7rem,3.6vw,2.5rem)] font-extrabold leading-[1.15] tracking-[-0.01em]">From the blog</h2>
				<a href="/blog/" class="text-base font-bold text-red no-underline hover:underline hover:underline-offset-4">All posts →</a>
			</div>
			{% if blog_featured %}
				<div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2 lg:[grid-template-columns:minmax(300px,1.15fr)_minmax(280px,1fr)]">
					<a href="{{ blog_featured.url }}" class="flex flex-col overflow-hidden rounded-[18px] bg-white text-ink no-underline shadow-card transition-[box-shadow,transform] hover:-translate-y-0.5 hover:shadow-card-hover-lg md:col-span-2 lg:col-span-1">
						<div class="relative flex aspect-video items-start p-3.5 {% if not blog_featured.image %}{{ stripe }}{% endif %}">
							{% if blog_featured.image %}
								<img src="{{ blog_featured.image.src }}" alt="{{ blog_featured.image.alt }}" class="absolute inset-0 h-full w-full object-cover">
							{% endif %}
							<span class="relative {{ cat_featured_pill[blog_featured.cat] }} text-white rounded-full px-3.5 py-[5px] text-[0.75rem] font-bold uppercase tracking-[0.06em]">{{ blog_featured.cat_label }}</span>
						</div>
						<div class="flex flex-col gap-2.5 px-7 pb-[30px] pt-[26px]">
							<span class="text-[0.82rem] font-semibold text-text-muted">{{ blog_featured.date }} · {{ blog_featured.read }}</span>
							<span class="font-display text-[clamp(1.2rem,2.2vw,1.45rem)] font-extrabold leading-[1.25] [text-wrap:balance]">{{ blog_featured.title }}</span>
							<span class="text-base leading-[1.65] text-text-muted">{{ blog_featured.excerpt }}</span>
							<span class="mt-1 text-[0.95rem] font-bold text-red">Read the post →</span>
						</div>
					</a>
					<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-1">
						{% for row in blog_rows %}
							<a href="{{ row.url }}" class="grid flex-1 grid-cols-[100px_1fr] overflow-hidden rounded-[18px] bg-white text-ink no-underline shadow-card transition-[box-shadow,transform] hover:-translate-y-0.5 hover:shadow-card-hover-lg sm:[grid-template-columns:130px_1fr]">
								{% if row.image %}
									<span class="min-h-[130px] overflow-hidden"><img src="{{ row.image.src }}" alt="{{ row.image.alt }}" class="h-full w-full object-cover"></span>
								{% else %}
									<span aria-hidden="true" class="min-h-[130px] {{ stripe }}"></span>
								{% endif %}
								<span class="flex flex-col justify-center gap-[9px] px-6 py-5">
									<span class="{{ cat_row_pill[row.cat] }} self-start rounded-full border-2 px-3 py-[3px] text-[0.72rem] font-bold uppercase tracking-[0.06em]">{{ row.cat_label }}</span>
									<span class="font-display text-[1.08rem] font-bold leading-[1.35]">{{ row.title }}</span>
									<span class="text-[0.85rem] font-semibold text-text-muted">{{ row.date }}</span>
								</span>
							</a>
						{% endfor %}
					</div>
				</div>
			{% else %}
				<div class="flex flex-col items-center gap-2.5 rounded-[18px] border border-hairline bg-off-white px-6 py-16 text-center">
					<span class="font-display text-[1.15rem] font-bold">Posts coming soon</span>
					<span class="text-base text-text-muted">The chapter is writing its first dispatches — check back shortly.</span>
				</div>
			{% endif %}
		</div>
	</section>

	{# ============ GET INVOLVED STEPS ============ #}
	<section id="get-involved" class="get-involved-steps bg-ink px-4 py-16 text-white md:px-6 md:py-24" data-tone="ink">
		<div class="mx-auto flex max-w-[1140px] flex-col gap-12">
			<div class="flex flex-col gap-3.5">
				<div class="text-[0.82rem] font-bold uppercase tracking-[0.14em] text-pink">Get involved</div>
				<h2 class="m-0 max-w-[20ch] font-display text-[clamp(1.7rem,3.6vw,2.5rem)] font-extrabold leading-[1.15] tracking-[-0.01em]">Three steps to start organizing</h2>
			</div>
			<div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-7">
				{% set steps = [
					{ num: '01', title: 'Join DSA', body: 'Become a national DSA member — dues are sliding-scale, and membership automatically connects you to our chapter.', link_label: 'Sign up at dsausa.org →', href: chapter.join_url, external: true },
					{ num: '02', title: 'Come to RGV-DSA 101', body: 'Our intro session for new and curious folks — what we do, how the chapter works, and how you can plug in. Virtual and in-person options.', link_label: 'Find a session →', href: '#events', external: false },
					{ num: '03', title: 'Plug into the work', body: 'Join a committee, get on our WhatsApp, and show up. Members receive an invite to our communication channels after onboarding.', link_label: 'See committees →', href: '/get-involved/#committees', external: false }
				] %}
				{% for step in steps %}
					<div class="step-card flex flex-col gap-3 rounded-[18px] bg-ink-card p-7">
						<div class="font-display text-[1.7rem] font-extrabold text-pink">{{ step.num }}</div>
						<div class="text-[1.18rem] font-bold">{{ step.title }}</div>
						<p class="m-0 text-base leading-[1.65] text-muted-on-ink">{{ step.body }}</p>
						<a href="{{ step.href }}"{% if step.external %} target="_blank" rel="noopener"{% endif %}
							class="mt-auto self-start text-[0.95rem] font-bold text-white underline underline-offset-4 hover:text-pink">
							{{ step.link_label }}
						</a>
					</div>
				{% endfor %}
			</div>
			<div class="flex flex-col items-stretch gap-3 border-t border-ink-soft pt-8 md:flex-row md:flex-wrap md:items-center md:gap-4">
				<span class="text-[0.95rem] font-bold text-muted-on-ink">Follow along:</span>
				<a href="https://www.instagram.com/dsa_rgv/" target="_blank" rel="noopener"
					class="w-full rounded-full bg-white px-[22px] py-2.5 text-center text-[0.95rem] font-bold text-ink no-underline transition-colors hover:bg-pink md:w-auto">
					Instagram <span class="notranslate">@dsa_rgv</span>
				</a>
				<a href="mailto:{{ chapter.contact_email }}"
					class="w-full rounded-full border-2 border-[#57534e] px-[21px] py-[9px] text-center text-[0.95rem] font-bold text-white no-underline transition-colors hover:border-white md:w-auto">
					Email us
				</a>
			</div>
		</div>
	</section>

{% endblock %}
