{% extends "base.twig" %}

{#
  Blog archive (posts page). One BlogArchive island serves browse, category
  filter, and search states; index/category/search templates all land here.
  inc/blog.php injects archive_posts / archive_categories / archive_pagination
  when published posts exist; the island fixture holds when they are unset.
#}

{% block content %}
	{# archive.twig / search.twig override page_header_props with the computed context title. #}
	{% set page_header_props = page_header_props|default({
		title: 'Chapter Blog',
		lede: posts_page_lede|default('News, analysis, and dispatches from RGV-DSA organizers across the Valley.'),
		crumbs: [{ label: 'Home', href: '/' }]
	}) %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	{% set archive_props = {
		showSubscribe: true,
		newsletterUrl: chapter.newsletter_url
	} %}
	{% if archive_posts is defined %}
		{% set archive_props = archive_props|merge({ posts: archive_posts }) %}
	{% endif %}
	{% if archive_categories is defined %}
		{% set archive_props = archive_props|merge({ categories: archive_categories }) %}
	{% endif %}
	{% if archive_pagination is defined %}
		{% set archive_props = archive_props|merge({ pagination: archive_pagination }) %}
	{% endif %}
	<div data-vue-island="BlogArchive" data-props='{{ archive_props|json_encode|e("html_attr") }}'></div>
{% endblock %}
