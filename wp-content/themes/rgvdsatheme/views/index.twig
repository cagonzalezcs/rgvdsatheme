{% extends "base.twig" %}

{#
  Blog archive (posts page). One BlogArchive island serves browse, category
  filter, and search states; index/category/search templates all land here.
  inc/blog.php always sets archive_posts / archive_total / archive_categories
  / archive_pagination / archive_api_base; the island fetches interaction
  states from /rgvdsa/v1/posts and owns the designed empty state.
#}

{% block content %}
	{# archive.twig / search.twig override page_header_props with the computed context title. #}
	{% set page_header_props = page_header_props|default({
		title: 'Chapter Blog',
		lede: posts_page_lede|default('News, analysis, and dispatches from RGV-DSA organizers across the Valley.'),
		crumbs: [{ label: 'Home', href: '/' }]
	}) %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	{% set archive_props = {
		initialPosts: archive_posts,
		initialTotal: archive_total,
		categories: archive_categories,
		pagination: archive_pagination,
		apiBase: archive_api_base,
		lang: current_language,
		showSubscribe: true,
		newsletterUrl: chapter.newsletter_url
	} %}
	{% set cat_labels = {} %}
	{% for c in archive_categories %}
		{% set cat_labels = cat_labels|merge({ (c.id): c.label }) %}
	{% endfor %}

	<div data-vue-island="BlogArchive" data-props='{{ archive_props|json_encode|e("html_attr") }}'>
		{# Server-rendered fallback: crawlable + readable without JS (excerpts,
		   dates, pagination in the initial HTML). createApp().mount() replaces
		   it on hydration — same pattern as single.twig. #}
		<section class="bg-white px-6 py-12">
			<div class="mx-auto flex max-w-[920px] flex-col gap-10">
				{% for p in archive_posts %}
					<article class="flex flex-col gap-2">
						<p class="text-[0.82rem] font-bold uppercase tracking-wide text-text-muted">{{ cat_labels[p.cat]|default(p.cat) }}</p>
						<h2 class="font-display text-[1.4rem] font-black leading-[1.2]">
							<a href="{{ p.url }}">{{ p.title }}</a>
						</h2>
						{% if p.dek|default(p.excerpt) %}
							<p class="text-text-muted">{{ p.dek|default(p.excerpt) }}</p>
						{% endif %}
						<p class="text-[0.92rem] text-text-muted">{{ p.date }} · {{ p.readMinutes }} min read</p>
					</article>
				{% endfor %}
				{% if archive_pagination %}
					<nav class="flex justify-between gap-4" aria-label="Posts pagination">
						{% if archive_pagination.newerUrl %}<a href="{{ archive_pagination.newerUrl }}">Newer posts</a>{% endif %}
						{% if archive_pagination.olderUrl %}<a class="ml-auto" href="{{ archive_pagination.olderUrl }}">Older posts</a>{% endif %}
					</nav>
				{% endif %}
			</div>
		</section>
	</div>
{% endblock %}
