{% extends "base.twig" %}

{#
  Blog archive (posts page). One BlogArchive island serves browse, category
  filter, and search states; index/category/search templates all land here.
  Posts are the prototype fixture (default prop inside the island) until
  Phase 6 passes a Timber query via data-props, e.g. posts: posts_json.
#}

{% block content %}
	{% set page_header_props = {
		title: 'Chapter Blog',
		lede: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
		crumbs: [{ label: 'Home', href: '/' }]
	} %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	{% set archive_props = {
		showSubscribe: true
	} %}
	<div data-vue-island="BlogArchive" data-props='{{ archive_props|json_encode|e("html_attr") }}'></div>
{% endblock %}
