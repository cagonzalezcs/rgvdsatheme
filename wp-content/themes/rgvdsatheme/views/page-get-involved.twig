{% extends "base.twig" %}

{#
  Get Involved page — v2 (warm/rounded) skin. Ported from
  design_handoff_rgvdsa_vue/designs/Get Involved.dc.html.
  Section content comes from the "Get Involved page" ACF group
  (inc/pages.php), defaulted in PHP to the design copy — `gi.*` is always
  fully set.
#}

{% set h2class = 'scroll-mt-[calc(110px+var(--wp-admin--admin-bar--height,0px))] border-b-[3px] border-brand-red pb-3 font-display text-[1.55rem] font-extrabold tracking-[-0.01em]' %}
{% set nav_link = 'rounded-[8px] px-3.5 py-2 text-[0.95rem] font-semibold text-ink no-underline hover:bg-tint hover:text-red' %}

{% block content %}
	{% set page_header_props = {
		title: post.title ? function('html_entity_decode', post.title) : "Get involved",
		lede: page_lede|default('') ?: "No experience needed, no perfect politics required. If you want a better Valley, there's a place for you here.",
		crumbs: [{ label: "Home", href: "/" }]
	} %}
	<div data-vue-island="PageHeader" data-props='{{ page_header_props|json_encode|e("html_attr") }}'></div>

	<section class="bg-white px-4 pb-20 pt-12 md:px-6 md:pb-24 md:pt-16" data-tone="cream">
		<div class="mx-auto grid max-w-[1140px] items-start gap-10 md:gap-14 lg:[grid-template-columns:minmax(300px,1fr)_300px]">

			{# On-this-page nav hoisted above the article for <lg (05 §4): list on mobile,
			   chip row on tablet. Sticky sidebar copy below is lg-only. #}
			<nav aria-label="On this page" class="flex flex-col gap-0.5 rounded-[14px] bg-off-white p-3 md:flex-row md:flex-wrap md:items-center md:gap-2 lg:hidden">
				<div class="mb-1 px-3.5 py-1.5 font-display text-[0.82rem] font-bold uppercase tracking-[0.08em] text-text-muted md:mb-0 md:py-0">On this page</div>
				<a href="#join" class="{{ nav_link }} md:rounded-full md:border md:border-border-control md:bg-white">How to join</a>
				<a href="#committees" class="{{ nav_link }} md:rounded-full md:border md:border-border-control md:bg-white">Committees</a>
				<a href="#channels" class="{{ nav_link }} md:rounded-full md:border md:border-border-control md:bg-white">Communication channels</a>
				<a href="#faq" class="{{ nav_link }} md:rounded-full md:border md:border-border-control md:bg-white">Common questions</a>
			</nav>

			<article class="flex min-w-0 flex-col gap-7">

				{# ---- How to join ---- #}
				<h2 id="join" class="m-0 {{ h2class }}">How to join</h2>

				<div class="flex flex-col gap-3.5">
					{% for step in gi.steps %}
						<div class="grid grid-cols-[52px_1fr] gap-4 rounded-[16px] bg-white p-6 shadow-card sm:gap-5 sm:[grid-template-columns:64px_1fr]">
							<div class="flex size-[52px] items-center justify-center rounded-[12px] bg-brand-red font-display text-[1.6rem] font-extrabold text-white">{{ loop.index }}</div>
							<div class="flex flex-col gap-2">
								<div class="text-[1.1rem] font-bold">{{ step.title }}</div>
								<p class="m-0 text-base leading-[1.7] text-text-body">{{ step.body|raw }}</p>
								{% if step.link_label and step.href %}
									<a href="{{ step.href }}"{% if step.external %} target="_blank" rel="noopener"{% endif %} class="self-start text-[0.95rem] font-bold text-red no-underline hover:underline hover:underline-offset-4">{{ step.link_label }}</a>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>

				{# ---- Committees (cards edited under Chapter Settings) ---- #}
				<h2 id="committees" class="mx-0 mb-0 mt-4 {{ h2class }}">Committees</h2>
				<p class="m-0 text-[1.05rem] leading-[1.78] text-text-body">{{ gi.committees_intro }}</p>

				<div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]">
					{% for committee in chapter.committees %}
						<div class="flex flex-col gap-2 rounded-[14px] border-t-4 border-brand-red bg-white p-[22px] shadow-card">
							<div class="font-display text-base font-bold text-red">{{ committee.name }}</div>
							<p class="m-0 text-[0.95rem] leading-[1.65] text-text-body">{{ committee.desc }}</p>
						</div>
					{% endfor %}
				</div>

				{# ---- Communication channels ---- #}
				<h2 id="channels" class="mx-0 mb-0 mt-4 {{ h2class }}">Communication channels</h2>

				<div class="flex flex-col gap-3.5">
					{% for channel in gi.channels %}
						<div class="flex flex-col items-start gap-4 rounded-[14px] bg-white px-6 py-5 shadow-card sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-5">
							<div class="flex flex-col gap-[3px]">
								<span class="text-[1.05rem] font-bold">{{ channel.label }}</span>
								{% if channel.desc %}
									<span class="text-[0.9rem] text-text-muted">{{ channel.desc }}</span>
								{% endif %}
							</div>
							{% if channel.url and channel.link_label %}
								<a href="{{ channel.url }}"{% if channel.external %} target="_blank" rel="noopener"{% endif %} class="whitespace-nowrap rounded-full border-2 border-red px-5 py-2 text-[0.9rem] font-bold text-red no-underline transition-colors hover:border-red-hover hover:bg-wash">{{ channel.link_label }}</a>
							{% elseif channel.badge %}
								<span class="rounded-full border border-dashed border-border-muted px-4 py-2 text-[0.8rem] font-bold text-text-muted">{{ channel.badge }}</span>
							{% endif %}
						</div>
					{% endfor %}
				</div>

				{# ---- Common questions ---- #}
				<h2 id="faq" class="mx-0 mb-0 mt-4 {{ h2class }}">Common questions</h2>

				<div data-vue-island="FaqAccordion" data-props='{{ { items: gi.faq_items }|json_encode|e("html_attr") }}'></div>

			</article>

			{# ---- Sidebar ---- #}
			<aside aria-label="Page navigation" class="flex flex-col gap-7 lg:sticky lg:top-[calc(110px+var(--wp-admin--admin-bar--height,0px))]">
				<nav aria-label="On this page" class="hidden flex-col gap-0.5 rounded-[14px] bg-off-white p-3 lg:flex">
					<div class="mb-1 px-3.5 py-1.5 font-display text-[0.82rem] font-bold uppercase tracking-[0.08em] text-text-muted">On this page</div>
					<a href="#join" class="{{ nav_link }}">How to join</a>
					<a href="#committees" class="{{ nav_link }}">Committees</a>
					<a href="#channels" class="{{ nav_link }}">Communication channels</a>
					<a href="#faq" class="{{ nav_link }}">Common questions</a>
				</nav>

				<div class="flex flex-col gap-3 rounded-[16px] bg-ink p-6 text-white" data-tone="ink">
					<div class="font-display text-[0.98rem] font-bold">{{ gi.card.heading }}</div>
					<p class="m-0 text-[0.9rem] leading-[1.6] text-muted-on-ink">{{ gi.card.body }}</p>
					<a href="{{ gi.card.url }}"{% if gi.card.external %} target="_blank" rel="noopener"{% endif %} class="self-start rounded-full bg-white px-[18px] py-[9px] text-[0.88rem] font-bold text-ink no-underline transition-colors hover:bg-pink">{{ gi.card.link_label }}</a>
				</div>

				<nav aria-label="Related pages" class="flex flex-col gap-0.5 rounded-[14px] bg-tint p-3">
					<div class="mb-1 px-3.5 py-1.5 font-display text-[0.82rem] font-bold uppercase tracking-[0.08em] text-red">Related</div>
					<a href="/calendar/" class="rounded-[8px] px-3.5 py-2 text-[0.95rem] font-semibold text-ink no-underline hover:bg-white hover:text-red">Event Calendar</a>
					<a href="/bylaws-code-of-conduct/" class="rounded-[8px] px-3.5 py-2 text-[0.95rem] font-semibold text-ink no-underline hover:bg-white hover:text-red">Bylaws &amp; Code of Conduct</a>
					<a href="/about/#mission" class="rounded-[8px] px-3.5 py-2 text-[0.95rem] font-semibold text-ink no-underline hover:bg-white hover:text-red">Mission &amp; History</a>
				</nav>
			</aside>

		</div>
	</section>
{% endblock %}
