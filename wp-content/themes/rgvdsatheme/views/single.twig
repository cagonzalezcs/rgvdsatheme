{% extends "base.twig" %}

{#
  Single post. The island renders its own red hero, so no PageHeader here.
  Content is the prototype fixture (default prop inside the island) until
  Phase 6 wires post title/dek/byline + the post_blocks ACF flexible-content
  stack via data-props. Comments are out of the design's scope.
#}

{% block content %}
	{% set post_props = {
		showMetaRail: false
	} %}
	<div data-vue-island="SinglePost" data-props='{{ post_props|json_encode|e("html_attr") }}'></div>
{% endblock %}
